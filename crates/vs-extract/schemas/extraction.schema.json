{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window extraction output",
  "type": "object",
  "required": ["entities", "assertions"],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "surface", "type", "block", "quote"],
        "properties": {
          "id": { "type": "string", "description": "window-local id, e.g. e1; reuse for coreferent mentions" },
          "surface": { "type": "string" },
          "type": { "type": "string", "description": "open type, e.g. method, dataset, metric, organisation, person, chemical, component" },
          "block": { "type": "string", "description": "block label, e.g. B12" },
          "quote": { "type": "string", "description": "exact text from the block containing the mention" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "kind", "args", "evidence", "confidence"],
        "properties": {
          "predicate": { "type": "string", "description": "frame name (result, uses, compares, ...) or free predicate" },
          "kind": { "enum": ["binary", "nary", "attribute"] },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role"],
              "properties": {
                "role": { "type": "string" },
                "entity": { "type": "string", "description": "entity id" },
                "literal": { "type": "string" },
                "unit": { "type": "string" }
              }
            }
          },
          "qualifiers": {
            "type": "object",
            "properties": {
              "negated": { "type": "boolean" },
              "hedged": { "type": "boolean" },
              "condition": { "type": "string" },
              "time": { "type": "string" }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["block", "quote"],
              "properties": { "block": { "type": "string" }, "quote": { "type": "string" } }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
