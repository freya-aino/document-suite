{
  "max_candidates": 400,
  "templates": [
    {
      "id": "e2e",
      "description": "One end-to-end document VLM call per page.",
      "slots": {
        "model": [
          "paddleocr-vl-1.5",
          "mineru-2.5"
        ]
      },
      "dag": {
        "output": "parse",
        "nodes": [
          {
            "id": "parse",
            "step": "page.parse_e2e",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "model": "{model}"
            }
          }
        ]
      }
    },
    {
      "id": "native-layout-tables",
      "description": "Born-digital pages: native text layer + layout model; tables via a doc VLM, no OCR.",
      "slots": {
        "layout_model": [
          "mineru-2.5"
        ],
        "table_model": [
          "paddleocr-vl-1.5",
          "mineru-2.5"
        ]
      },
      "dag": {
        "output": "merge",
        "nodes": [
          {
            "id": "layout",
            "step": "layout.detect",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "model": "{layout_model}"
            }
          },
          {
            "id": "tables",
            "step": "table.recognize",
            "inputs": [
              "$page_image",
              "layout"
            ],
            "params": {
              "model": "{table_model}"
            },
            "optional": true
          },
          {
            "id": "merge",
            "step": "blocks.merge_native",
            "inputs": [
              "$text_layer",
              "layout",
              "tables"
            ]
          }
        ]
      }
    },
    {
      "id": "layout-region-ocr",
      "description": "Scans: layout model, then per-region OCR.",
      "slots": {
        "layout_model": [
          "mineru-2.5"
        ],
        "ocr_model": [
          "paddleocr-vl-1.5"
        ]
      },
      "dag": {
        "output": "text",
        "nodes": [
          {
            "id": "layout",
            "step": "layout.detect",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "model": "{layout_model}"
            }
          },
          {
            "id": "text",
            "step": "region.ocr",
            "inputs": [
              "$page_image",
              "layout"
            ],
            "params": {
              "model": "{ocr_model}"
            }
          }
        ]
      }
    },
    {
      "id": "deskew-layout-region-ocr",
      "description": "Scans, deskewed first: the same pipeline as layout-region-ocr with conditioning in front, so scoring shows whether straightening the page pays for itself.",
      "slots": {
        "layout_model": [
          "mineru-2.5"
        ],
        "ocr_model": [
          "paddleocr-vl-1.5"
        ],
        "min_apply_deg": [
          0.2,
          1.0
        ]
      },
      "dag": {
        "output": "text",
        "nodes": [
          {
            "id": "straight",
            "step": "page.deskew",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "max_deg": 5.0,
              "min_apply_deg": "{min_apply_deg}"
            }
          },
          {
            "id": "layout",
            "step": "layout.detect",
            "inputs": [
              "straight"
            ],
            "params": {
              "model": "{layout_model}"
            }
          },
          {
            "id": "text",
            "step": "region.ocr",
            "inputs": [
              "straight",
              "layout"
            ],
            "params": {
              "model": "{ocr_model}"
            }
          }
        ]
      }
    },
    {
      "id": "oriented-e2e",
      "description": "Scans and photographs that may be sideways or upside down: stand the page up, straighten it, then one end-to-end call. page.orient's quarter turn rests on a strong measurement and its 180 flip on a weak one, so min_asymmetry is a slot \u2014 a high value disables the flip, which is how scoring decides whether it earns its place on a given page class.",
      "slots": {
        "model": [
          "paddleocr-vl-1.5",
          "mineru-2.5"
        ],
        "min_asymmetry": [
          0.02,
          1.0
        ]
      },
      "dag": {
        "output": "parse",
        "nodes": [
          {
            "id": "upright",
            "step": "page.orient",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "axis_margin": 1.3,
              "min_asymmetry": "{min_asymmetry}"
            }
          },
          {
            "id": "straight",
            "step": "page.deskew",
            "inputs": [
              "upright"
            ],
            "params": {
              "max_deg": 5.0,
              "min_apply_deg": 0.2
            }
          },
          {
            "id": "parse",
            "step": "page.parse_e2e",
            "inputs": [
              "straight"
            ],
            "params": {
              "model": "{model}"
            }
          }
        ]
      }
    },
    {
      "id": "conditioned-e2e",
      "description": "Photographed or poor-quality scans: normalise contrast, optionally denoise, then one end-to-end call. Binarisation is NOT combined with the figure branch anywhere, because page.binarize outputs greyscale.",
      "slots": {
        "model": [
          "paddleocr-vl-1.5",
          "mineru-2.5"
        ],
        "radius": [
          1,
          2
        ]
      },
      "dag": {
        "output": "parse",
        "nodes": [
          {
            "id": "clean",
            "step": "page.denoise",
            "inputs": [
              "$page_image"
            ],
            "params": {
              "radius": "{radius}"
            }
          },
          {
            "id": "even",
            "step": "page.normalize",
            "inputs": [
              "clean"
            ],
            "params": {}
          },
          {
            "id": "parse",
            "step": "page.parse_e2e",
            "inputs": [
              "even"
            ],
            "params": {
              "model": "{model}"
            }
          }
        ]
      }
    },
    {
      "id": "binarized-region-ocr",
      "description": "Faint or bleed-through scans: crop the scanner border, binarise, then per-region OCR. Whether binarisation helps is model-dependent, which is exactly what this template exists to measure.",
      "slots": {
        "layout_model": [
          "mineru-2.5"
        ],
        "ocr_model": [
          "paddleocr-vl-1.5"
        ]
      },
      "dag": {
        "output": "text",
        "nodes": [
          {
            "id": "trimmed",
            "step": "page.crop_margins",
            "inputs": [
              "$page_image"
            ],
            "params": {}
          },
          {
            "id": "bw",
            "step": "page.binarize",
            "inputs": [
              "trimmed"
            ],
            "params": {}
          },
          {
            "id": "layout",
            "step": "layout.detect",
            "inputs": [
              "bw"
            ],
            "params": {
              "model": "{layout_model}"
            }
          },
          {
            "id": "text",
            "step": "region.ocr",
            "inputs": [
              "bw",
              "layout"
            ],
            "params": {
              "model": "{ocr_model}"
            }
          }
        ]
      }
    }
  ]
}
