{
  "realm": "koki",
  "displayName": "KoKI \u2014 document-suite development realm",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "ds-admin",
        "description": "DAG-list administration and /metrics in ds-api (auth.admin_role)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ds-api",
      "name": "document-suite API",
      "description": "Development client. The organization is a hardcoded claim, not a user attribute; see deploy/keycloak/README.md.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ds-api-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience: ds-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ds-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "claim.value": "t1",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "department",
            "claim.value": "dept-a",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "workspaces",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "workspaces",
            "claim.value": "[\"ws-red\",\"ws-blue\"]",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ds-api-t2",
      "name": "document-suite API \u2014 second organization",
      "description": "A token for organization t2 with no admin role, for checking tenant isolation by hand.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ds-api-t2-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "audience: ds-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ds-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization",
            "claim.value": "t2",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-ds-api",
      "enabled": true,
      "serviceAccountClientId": "ds-api",
      "realmRoles": [
        "ds-admin"
      ]
    },
    {
      "username": "dev",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "email": "dev@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ds-admin"
      ]
    }
  ]
}
