{
  "boot-source": {
    "kernel_image_path": "/var/lib/vs/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off ro vs.role=page vs.ip=172.16.1.2/30 vs.gw=172.16.1.1 vs.dns=172.16.1.1"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/var/lib/vs/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true
    },
    {
      "drive_id": "scratch",
      "path_on_host": "/var/lib/vs/scratch-0001.ext4",
      "is_root_device": false,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 1,
    "mem_size_mib": 1024
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "guest_mac": "AA:FC:00:00:00:01",
      "host_dev_name": "tap-vs-1",
      "rx_rate_limiter": { "bandwidth": { "size": 125000000, "refill_time": 1000 } },
      "tx_rate_limiter": { "bandwidth": { "size": 125000000, "refill_time": 1000 } }
    }
  ],
  "mmds-config": {
    "version": "V2",
    "network_interfaces": ["eth0"]
  }
}
