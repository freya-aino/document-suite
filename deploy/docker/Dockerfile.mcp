# syntax=docker/dockerfile:1.7
#
# The LLM tool service as its own image: `vs-mcp`, which serves the suite's work as Model
# Context Protocol tools over the suite's HTTP API. See crates/vs-mcp/SPEC.md.
#
#   docker build -f deploy/docker/Dockerfile.mcp -t document-suite-mcp:dev .
#
# Build it from the repository root: the context is the workspace, because the build
# compiles it.
#
# Its own image rather than a second entrypoint on the service image, for the reason
# decision D16 made it its own service: it needs none of what that image carries. No
# pdfium — it renders nothing; no config file — every parameter is a flag or an
# environment variable; no scratch directory — it writes no temporary files. What it needs
# is a CA bundle, to verify the suite's certificate, and that is all. The result is a few
# megabytes on a slim base, and it holds no credentials of its own to leak (D16).

# ───────────────────────────── build ─────────────────────────────
# The same pinned toolchain as the service image, so one bump moves both.
FROM rust:1.100-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# Cache mounts rather than a dependency-only pre-build, as in the service image. `target`
# is a cache mount, so the binary has to be copied out inside the same step.
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/src/target,sharing=locked \
    cargo build --release --locked -p vs-mcp \
 && cp target/release/vs-mcp /usr/local/bin/vs-mcp

# ───────────────────────────── runtime ─────────────────────────────
FROM debian:bookworm-slim
# ca-certificates: the suite is reached over HTTPS in any real deployment.
# curl: only for HEALTHCHECK below — drop both if your orchestrator probes /healthz itself.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --shell /usr/sbin/nologin --home-dir /nonexistent vs

COPY --from=build /usr/local/bin/vs-mcp /usr/local/bin/vs-mcp

# No VS_API_TOKEN, and none is accepted here: in HTTP mode the token is the caller's, taken
# from each request's Authorization header (D16). An image that baked one would be an image
# that acts as somebody.
ENV VS_API_URL=http://vs-suite:8080 \
    VS_MCP_ADDR=0.0.0.0:8081 \
    RUST_LOG=info

EXPOSE 8081
USER vs

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/bin/sh", "-c", "curl -fsS \"http://127.0.0.1:${VS_MCP_ADDR##*:}/healthz\" >/dev/null || exit 1"]

ENTRYPOINT ["/usr/local/bin/vs-mcp"]
# `http` rather than `stdio`: a container is a service, and the stdio transport is for a
# client that launches one process per user. Add --allowed-origin for a browser-based
# client; without one, a request carrying an Origin header is refused, which is what stops
# a web page from using this server as the user.
CMD ["http"]
